      "countriesSupported": "ES, AR, CL, PT, FR, IT, DE, IE, GB, AT, CH, NL, BE, LU, PL, CZ, SK, HU, SI, SE, NO, DK, FI, EE, LV, LT, GR, HR, RO, BG, RS, US, AU, NZ, JP",
