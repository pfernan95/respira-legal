<!DOCTYPE html>
{# Language of THIS page. Absent means Spanish, which is every route that
   existed before the expansion — so nothing about their output changes.
   Note the un-trimmed opening tag: `{#-` would eat the newline after the
   doctype and rewrite all 164 existing files for no reason. #}
{%- set L = i18nWeb[lang or "es"] -%}
<html lang="{{ L.htmlLang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {%- set canonical = "https://respiraapp.fit" + (page.url | extensionless) %}
  {%- if noindex %}
  <meta name="robots" content="noindex,nofollow">
  {%- else %}
  <meta name="robots" content="index,follow,max-image-preview:large">
  <link rel="canonical" href="{{ canonical }}">
  {#- hreflang is declared ONLY when the counterpart page really exists, named
      by `altEs`/`altEn` in the front matter. Pointing at a URL that 404s is
      worse than declaring nothing: Google drops the whole cluster. Most of the
      164 Spanish routes have no English twin and correctly emit none. -#}
  {%- if altEs and altEn %}
  <link rel="alternate" hreflang="es-ES" href="https://respiraapp.fit{{ altEs }}">
  <link rel="alternate" hreflang="en-US" href="https://respiraapp.fit{{ altEn }}">
  <link rel="alternate" hreflang="x-default" href="https://respiraapp.fit{{ altEs }}">
  {%- endif %}
  {%- endif %}
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAF8F5">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16181A">

  <meta property="og:type" content="{{ ogType or "website" }}">
  <meta property="og:site_name" content="Respira">
  <meta property="og:locale" content="{{ L.ogLocale }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://respiraapp.fit/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle or title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://respiraapp.fit/og-image.png">

  <meta name="apple-itunes-app" content="app-id=6759206565">

  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preload" href="/assets/fonts/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>

  <header class="site-header">
    <a class="brand" href="{{ L.home }}">
      <img class="brand-mark" src="/apple-touch-icon.png" width="28" height="28" alt="" aria-hidden="true">
      Respira
    </a>
    <nav aria-label="{{ L.mainNav }}">
      <a href="{{ L.home }}">{{ L.nav.home }}</a>
      <a href="{{ L.nav.support }}">{{ L.nav.supportLabel }}</a>
      <a href="https://apps.apple.com/app/6759206565" rel="noopener">{{ L.nav.download }}</a>
    </nav>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <nav class="cluster" aria-label="{{ L.legalNav }}" style="justify-content:center">
      <a href="{{ L.footer.privacy.href }}">{{ L.footer.privacy.label }}</a>
      <a href="{{ L.footer.terms.href }}">{{ L.footer.terms.label }}</a>
      <a href="{{ L.footer.support.href }}">{{ L.footer.support.label }}</a>
      <a href="{{ L.footer.del.href }}">{{ L.footer.del.label }}</a>
      <a href="mailto:respiraapp.info@gmail.com">{{ L.footer.contact }}</a>
      {#- The language switch only appears where there IS a counterpart, for the
          same reason hreflang does. -#}
      {%- if altEs and altEn %}
      <a href="{{ altEn if (lang or "es") == "es" else altEs }}" rel="alternate"
         hreflang="{{ "en-US" if (lang or "es") == "es" else "es-ES" }}">{{ L.footer.switchLabel }}</a>
      {%- endif %}
    </nav>
    {%- if (lang or "es") == "es" %}
    <p>Polen por ciudad:
      <a href="/polen-madrid">Madrid</a> · <a href="/polen-barcelona">Barcelona</a> ·
      <a href="/polen-sevilla">Sevilla</a> · <a href="/polen-valencia">Valencia</a> ·
      <a href="/polen-zaragoza">Zaragoza</a> · <a href="/polen-malaga">Málaga</a> ·
      <a href="/polen-cordoba">Córdoba</a> · <a href="/polen-bilbao">Bilbao</a>
    </p>
    {%- endif %}
    <p>{{ L.footer.sourcesLead }} <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a> {{ L.footer.sourcesMid }}
      {{ L.footer.calendars }} <a href="https://www.uco.es/rea/" rel="noopener">{{ L.footer.reaName }}</a>.</p>
    <p>{{ L.footer.disclaimer }}</p>
    <p>&copy; 2026 Respira</p>
  </footer>

  {#- Web analytics (PostHog Cloud EU), opt-in only — see privacidad.html §3
      / privacy.html §3. Loads posthog-js directly from PostHog's own CDN
      (the same array.js their async snippet fetches) instead of the
      IIFE stub: fewer moving parts, and it only needs to run once consent
      is already granted, so the stub's pre-load event queueing buys nothing
      here. Nothing loads or runs until a choice is stored. -#}
  <div class="cookie-banner" id="cookie-banner" hidden>
    <p>{{ L.cookieBanner.text }} <a href="{{ L.footer.privacy.href }}">{{ L.cookieBanner.more }}</a></p>
    <div class="cluster">
      <button type="button" id="cookie-reject">{{ L.cookieBanner.reject }}</button>
      <button type="button" id="cookie-accept" class="accept">{{ L.cookieBanner.accept }}</button>
    </div>
  </div>
  <script>
    (function () {
      var KEY = "respira_analytics_consent";
      var POSTHOG_TOKEN = "phc_kT5Dg7n6REoP5dteywVpNwkGY4uoNtEkQDZduaSGXgNx";
      var consent = null;
      try { consent = localStorage.getItem(KEY); } catch (e) {}

      function loadPostHog() {
        if (window.posthog) return;
        var s = document.createElement("script");
        s.src = "https://eu-assets.i.posthog.com/static/array.js";
        s.async = true;
        s.onload = function () {
          window.posthog.init(POSTHOG_TOKEN, {
            api_host: "https://eu.i.posthog.com",
            defaults: "2026-05-05",
            person_profiles: "identified_only",
          });
        };
        document.head.appendChild(s);
      }

      var banner = document.getElementById("cookie-banner");
      if (consent === "granted") {
        loadPostHog();
      } else if (consent !== "denied" && banner) {
        banner.hidden = false;
      }

      if (banner) {
        var acceptBtn = document.getElementById("cookie-accept");
        var rejectBtn = document.getElementById("cookie-reject");
        if (acceptBtn) acceptBtn.addEventListener("click", function () {
          try { localStorage.setItem(KEY, "granted"); } catch (e) {}
          banner.hidden = true;
          loadPostHog();
        });
        if (rejectBtn) rejectBtn.addEventListener("click", function () {
          try { localStorage.setItem(KEY, "denied"); } catch (e) {}
          banner.hidden = true;
        });
      }
    })();
  </script>

</body>
</html>
