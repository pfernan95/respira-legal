{# Componentes del design system. Nunca comunican nivel solo con color:
   siempre palabra + (donde aplica) altura de barra como segunda codificación. #}

{%- set LEVEL_LABELS = { low: "Bajo", moderate: "Moderado", high: "Alto", very_high: "Muy alto", extreme: "Extremo" } -%}
{%- set LEVEL_ORDINAL = { low: 25, moderate: 50, high: 75, very_high: 90, extreme: 100 } -%}

{% macro cssLevel(level) %}{{ level | replace("_", "-") }}{% endmacro %}

{# Badge héroe: relleno sólido (pares fill/ink verificados ≥4.5:1 en webTokens) #}
{% macro nivelHero(level, detail) %}
<p class="nivel-hero lv-{{ cssLevel(level) }}">
  <span class="detail">Nivel general de polen</span>
  <strong class="word">{{ LEVEL_LABELS[level] }}</strong>
  {%- if detail %}<span class="detail">{{ detail }}</span>{% endif %}
</p>
{% endmacro %}

{# Badge inline: fondo tintado + borde, texto siempre --text-primary #}
{% macro nivelBadge(level, text) %}
<span class="nivel-badge bd-{{ cssLevel(level) }}">{{ text or LEVEL_LABELS[level] }}</span>
{% endmacro %}

{# Celda de la rejilla de pólenes del héroe: nombre + cifra + unidad + palabra.
   value/level null = sin cobertura del modelo para esta ubicación. #}
{% macro pollenCell(name, value, unit, level) %}
{%- if level == null -%}
<div class="pollen-cell" style="--_lv: var(--border)">
  <span class="name">{{ name }}</span>
  <span class="val">— <small>sin dato</small></span>
  <span class="small text-secondary">No disponible</span>
</div>
{%- else -%}
<div class="pollen-cell bd-{{ cssLevel(level) }}" style="--_lv: var(--level-{{ cssLevel(level) }})">
  <span class="name">{{ name }}</span>
  <span class="val">{{ value }} <small>{{ unit }}</small></span>
  <span class="small">{{ LEVEL_LABELS[level] }}</span>
</div>
{%- endif -%}
{% endmacro %}

{# Fila de polen estimado: nombre + valor + etiqueta de estimación + palabra #}
{% macro pollenRowEstimado(name, value, unit, level) %}
<div class="pollen-row">
  <span class="name">{{ name }}</span>
  {%- if level == "none" or value == 0 %}
  <span class="val">Sin presencia este mes</span>
  {%- else %}
  <span class="val num">≈{{ value }} {{ unit }}</span>
  {{ nivelBadge(level) }}
  {%- endif %}
  <span class="tag-estimacion">estimación estacional</span>
</div>
{% endmacro %}

{# Previsión 7 días: tabla real presentada como tira; minibarra = 2ª codificación #}
{% macro forecastTable(days, cityName) %}
<div class="scroller">
  <table class="forecast">
    <caption>Previsión de polen en {{ cityName }} — nivel general por día (máximo diario previsto)</caption>
    <thead>
      <tr>
        {%- for day in days %}
        <th scope="col"><span>{{ day.date | diaSemana }}</span><br><time class="fc-date" datetime="{{ day.date }}">{{ day.date | diaMes }}</time></th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      <tr>
        {%- for day in days %}
        {%- if day.overallLevel == null %}
        <td><span class="fc-word text-secondary">—</span></td>
        {%- else %}
        <td style="--_lv: var(--level-{{ cssLevel(day.overallLevel) }})">
          <div class="fc-bar" aria-hidden="true"><i style="block-size: {{ LEVEL_ORDINAL[day.overallLevel] }}%"></i></div>
          <span class="fc-word">{{ LEVEL_LABELS[day.overallLevel] }}</span>
          {%- if day.dominant %}<br><span class="fc-val small text-secondary">{{ day.dominant }}</span>{% endif %}
        </td>
        {%- endif %}
        {%- endfor %}
      </tr>
    </tbody>
  </table>
</div>
{% endmacro %}

{# Heatmap calendario polínico: 12 meses × tipos, mes actual con borde #}
{# Forecast by type: one row per modelled type, one column per forecast day,
   today first. Each cell carries the level word AND the value, so neither the
   colour nor the number has to be read alone. A null stays "sin dato". #}
{% macro tablaPorTipo(days, pollenTypes, cityName) %}
<div class="scroller">
  <table class="bytype">
    <caption>Polen en {{ cityName }} por tipo: máximo diario previsto, hoy y los próximos días (granos/m³)</caption>
    <thead>
      <tr>
        <th scope="col">Tipo</th>
        {%- for day in days %}
        <th scope="col"{% if loop.first %} aria-current="date"{% endif %}><span>{% if loop.first %}Hoy{% else %}{{ day.date | diaSemana }}{% endif %}</span><br><time class="fc-date" datetime="{{ day.date }}">{{ day.date | diaMes }}</time></th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      {%- for id, p0 in days[0].pollen %}
      <tr>
        <th scope="row">{{ pollenTypes[id].nameEs }}</th>
        {%- for day in days %}
        {%- set p = day.pollen[id] %}
        {%- if p and p.level %}
        <td class="bt-cell bd-{{ cssLevel(p.level) }}"><span class="bt-word">{{ LEVEL_LABELS[p.level] }}</span><span class="bt-val">{{ p.value }}</span></td>
        {%- else %}
        <td class="bt-cell bt-none"><span class="bt-word">sin dato</span></td>
        {%- endif %}
        {%- endfor %}
      </tr>
      {%- endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# A city's own month-by-month table (cityClimatology.json). A month under
   1 grain/m³ on average reads "casi nulo": that is what the model says, and
   it is not the same claim as "Bajo". #}
{% macro tablaClimatologia(clima, pollenTypes, monthNames, monthNamesFull, currentMonth, cityName) %}
<div class="scroller">
  <table class="bytype clima">
    <caption>Calendario polínico de {{ cityName }}: nivel medio de cada mes por tipo de polen (media de los máximos diarios, granos/m³)</caption>
    <thead>
      <tr>
        <th scope="col">Tipo</th>
        {%- for mo in monthNames %}
        <th scope="col"{% if loop.index0 == currentMonth %} aria-current="date"{% endif %}><abbr title="{{ monthNamesFull[loop.index0] }}">{{ mo }}</abbr></th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      {%- for id, months in clima %}
      <tr>
        <th scope="row">{{ pollenTypes[id].nameEs }}</th>
        {%- for c in months %}
        {%- if c == null %}
        <td class="bt-cell bt-none{% if loop.index0 == currentMonth %} bt-now{% endif %}"><span class="bt-word">sin dato</span></td>
        {%- elif c.value < 1 %}
        <td class="bt-cell bt-none{% if loop.index0 == currentMonth %} bt-now{% endif %}"><span class="bt-word">casi nulo</span><span class="bt-val">{{ c.value }}</span></td>
        {%- else %}
        <td class="bt-cell bd-{{ cssLevel(c.level) }}{% if loop.index0 == currentMonth %} bt-now{% endif %}"><span class="bt-word">{{ LEVEL_LABELS[c.level] }}</span><span class="bt-val">{{ c.value }}</span></td>
        {%- endif %}
        {%- endfor %}
      </tr>
      {%- endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{% macro heatmapCalendario(intensity, pollenTypes, monthNames, intensityLabels, currentMonth) %}
<div class="scroller">
  <table class="heatmap">
    <caption class="visually-hidden">Calendario polínico: intensidad por mes y tipo de polen</caption>
    <thead>
      <tr>
        <td></td>
        {%- for m in monthNames %}
        <th scope="col"{% if loop.index0 == currentMonth %} aria-current="date"{% endif %}>{{ m }}</th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      {%- for typeId, months in intensity %}
      <tr>
        <th scope="row">{{ pollenTypes[typeId].nameEs }}</th>
        {%- for lvl in months %}
        <td class="hm-cell {% if lvl == "none" %}hm-none{% endif %}{% if loop.index0 == currentMonth %} hm-now{% endif %}"
            {%- if lvl != "none" %} style="--_lv: var(--level-{{ cssLevel(lvl) }})"{% endif %}>
          <span class="visually-hidden">{{ monthNames[loop.index0] }}: {{ intensityLabels[lvl] }}</span>
        </td>
        {%- endfor %}
      </tr>
      {%- endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# Bloque de calidad del aire: EAQI dominante + estadísticas secundarias #}
{# Bandas oficiales del índice europeo (EAQI): 0-20-40-60-80-100+ #}
{% macro aqiLabel(v) %}{% if v <= 20 %}Buena{% elif v <= 40 %}Aceptable{% elif v <= 60 %}Moderada{% elif v <= 80 %}Mala{% elif v <= 100 %}Muy mala{% else %}Pésima{% endif %}{% endmacro %}
{% macro aqiToken(v) %}{% if v <= 20 %}good{% elif v <= 40 %}acceptable{% elif v <= 60 %}moderate{% elif v <= 80 %}poor{% elif v <= 100 %}bad{% else %}very-bad{% endif %}{% endmacro %}
{% macro aqiBlock(aqi) %}
<div class="aqi-block">
  <div class="aqi-main">
    <span class="val">{{ aqi.value }}</span>
    <span class="word"><i class="dot" aria-hidden="true" style="background: var(--aqi-{{ aqiToken(aqi.value) | trim }})"></i> {{ aqiLabel(aqi.value) | trim }}</span>
    <span class="small text-secondary">Índice europeo de calidad del aire (media de hoy)</span>
  </div>
  <dl class="aqi-stats">
    <div><dt class="lbl">PM2.5</dt><dd class="num">{{ aqi.pm2_5 }} <span class="small text-secondary">µg/m³</span></dd></div>
    <div><dt class="lbl">PM10</dt><dd class="num">{{ aqi.pm10 }} <span class="small text-secondary">µg/m³</span></dd></div>
    <div><dt class="lbl">Ozono</dt><dd class="num">{{ aqi.ozone }} <span class="small text-secondary">µg/m³</span></dd></div>
  </dl>
</div>
{% endmacro %}

{# Línea de actualización + fuentes: visible, no escondida en el pie #}
{% macro updateLine(fetchedAt, stale) %}
<p class="update-line">
  <span>{% if stale %}Datos del{% else %}Actualizado el{% endif %}
    <time datetime="{{ fetchedAt }}">{{ fetchedAt | fechaMadrid | fechaEs }} a las {{ fetchedAt | horaMadrid }}</time></span>
  <span>· Fuente: <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a> (CAMS)</span>
  <span>· Calendarios: <a href="https://www.uco.es/rea/" rel="noopener">REA</a></span>
</p>
{% endmacro %}

{# Insignia española por defecto. Las macros se importan SIN contexto
   (`{% import "macros.njk" as m %}`), así que no ven `i18nWeb` ni `lang`: lo
   que necesiten tiene que llegarles por parámetro o estar aquí. #}
{% set i18nWebEs = {
  badge: {
    src: "/assets/app-store-badge-es.svg",
    alt: "Consíguelo en el App Store",
    aria: "Descargar Respira en el App Store"
  }
} %}

{# CTA de app: badge oficial self-hosted, nunca sticky, nunca a todo ancho.
   La versión anterior tenía la insignia española fija y no la llamaba nadie. #}
{# `L` va AL FINAL y es opcional: hay seis llamantes en las plantillas
   españolas y cambiar el orden de los parámetros los rompió a los seis —160
   páginas con el h2 y el texto intercambiados. Sin `L` la insignia sale en
   español, que es lo correcto para las 164 rutas que ya existían. #}
{% macro ctaApp(titulo, texto, L) %}
<div class="cta-app">
  <h2>{{ titulo }}</h2>
  <p class="text-secondary">{{ texto }}</p>
  {{ storeBadge(L or i18nWebEs) }}
</div>
{% endmacro %}

{# La insignia sola, para el hero. Apple exige SU artwork —no una recreación—
   y que enlace a la ficha. width/height fijos para que no haya salto de
   layout: el SVG es 119.66×40, escalado a 156×52. #}
{# `href` overrides the default App Store link — used to route ragweed-intent
   pages through the Ragweed 2026 Custom Product Page instead of the default
   listing, so Apple Ads' CPP attribution and the ragweed-specific screenshots
   actually reach the visitor who searched for it. #}
{% macro storeBadge(L, href) %}
<a class="appstore-badge" href="{{ href or 'https://apps.apple.com/app/6759206565' }}"
   rel="noopener" aria-label="{{ L.badge.aria }}">
  <img src="{{ L.badge.src }}" alt="{{ L.badge.alt }}" width="156" height="52">
</a>
{% endmacro %}

{# English heatmap. A separate macro rather than a parameter on the Spanish
   one: changing an existing macro's signature is what broke 160 pages once
   in this repo, and the two differ in more than the labels anyway. #}
{% macro heatmapCalendarEn(intensity, names, monthNames, intensityLabels, currentMonth) %}
<div class="scroller">
  <table class="heatmap">
    <caption class="visually-hidden">Pollen calendar: intensity by month and species</caption>
    <thead>
      <tr>
        <td></td>
        {%- for m in monthNames %}
        <th scope="col"{% if loop.index0 == currentMonth %} aria-current="date"{% endif %}>{{ m }}</th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      {%- for row in intensity %}
      <tr>
        <th scope="row">{{ names[row.id] }}</th>
        {%- for lvl in row.months %}
        <td class="hm-cell {% if lvl == "none" %}hm-none{% endif %}{% if loop.index0 == currentMonth %} hm-now{% endif %}"
            {%- if lvl != "none" %} style="--_lv: var(--level-{{ cssLevel(lvl) }})"{% endif %}>
          <span class="visually-hidden">{{ monthNames[loop.index0] }}: {{ intensityLabels[lvl] }}</span>
        </td>
        {%- endfor %}
      </tr>
      {%- endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# English forecast by species for the /en/ city pages (Google Pollen API).
   Google gives an index, not grains, so the cells carry the level word only.
   "None" is Google's own reading for a plant out of season, and is shown. #}
{% macro forecastByTypeEn(days, order, names, cityName) %}
{%- set EN = { "none": "None", "low": "Low", "moderate": "Moderate", "high": "High", "very_high": "Very high" } %}
<div class="scroller">
  <table class="bytype">
    <caption>Pollen in {{ cityName }} by species: forecast level for today and the next days</caption>
    <thead>
      <tr>
        <th scope="col">Species</th>
        {%- for day in days %}
        <th scope="col"{% if loop.first %} aria-current="date"{% endif %}><span>{% if loop.first %}Today{% else %}{{ day.date | weekdayEn }}{% endif %}</span><br><time class="fc-date" datetime="{{ day.date }}">{{ day.date | dayMonthEn }}</time></th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      {%- for id in order %}
      {%- if days[0].plants[id] %}
      <tr>
        <th scope="row">{{ names[id] }}</th>
        {%- for day in days %}
        {%- set lvl = day.plants[id] %}
        {%- if not lvl %}
        <td class="bt-cell bt-none"><span class="bt-word">no data</span></td>
        {%- elif lvl == "none" %}
        <td class="bt-cell bt-none"><span class="bt-word">None</span></td>
        {%- else %}
        <td class="bt-cell bd-{{ cssLevel(lvl) }}"><span class="bt-word">{{ EN[lvl] }}</span></td>
        {%- endif %}
        {%- endfor %}
      </tr>
      {%- endif %}
      {%- endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# ---- UK and Ireland city pages (CAMS, English) ---- #}
{%- set LEVEL_EN = { "low": "Low", "moderate": "Moderate", "high": "High", "very_high": "Very high", "extreme": "Extreme" } -%}

{# The overall level and the type behind it, in English. #}
{% macro heroLevelEn(day, names) %}
<div class="hero-row">
  <p class="nivel-hero lv-{{ cssLevel(day.overallLevel) }}">
    <span class="detail">Overall pollen level</span>
    <strong class="word">{{ LEVEL_EN[day.overallLevel] }}</strong>
    <span class="detail">highest forecast for today</span>
  </p>
  <p class="dominante">
    <span class="detail">Main pollen today</span>
    {%- if day.dominant %}
    <strong>{{ names[day.dominant] }}</strong>
    <span class="detail">{{ LEVEL_EN[day.pollen[day.dominant].level] }} · {{ day.pollen[day.dominant].value }} grains/m³</span>
    {%- else %}
    <strong>None</strong>
    <span class="detail">Zero or near-zero values for every type</span>
    {%- endif %}
  </p>
</div>
{% endmacro %}

{# Forecast by type and day: level word plus the model value in every cell. #}
{% macro forecastByTypeGb(days, types, names, cityName) %}
<div class="scroller">
  <table class="bytype">
    <caption>Pollen in {{ cityName }} by type: highest forecast value of the day, today and the next days (grains/m³)</caption>
    <thead>
      <tr>
        <th scope="col">Type</th>
        {%- for day in days %}
        <th scope="col"{% if loop.first %} aria-current="date"{% endif %}><span>{% if loop.first %}Today{% else %}{{ day.date | weekdayEn }}{% endif %}</span><br><time class="fc-date" datetime="{{ day.date }}">{{ day.date | dayMonthGb }}</time></th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      {%- for id in types %}
      <tr>
        <th scope="row">{{ names[id] }}</th>
        {%- for day in days %}
        {%- set p = day.pollen[id] %}
        {%- if p and p.level %}
        <td class="bt-cell bd-{{ cssLevel(p.level) }}"><span class="bt-word">{{ LEVEL_EN[p.level] }}</span><span class="bt-val">{{ p.value }}</span></td>
        {%- else %}
        <td class="bt-cell bt-none"><span class="bt-word">no data</span></td>
        {%- endif %}
        {%- endfor %}
      </tr>
      {%- endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# Overall level per day, as bars with the word underneath (English). #}
{% macro forecastTableGb(days, names, cityName) %}
<div class="scroller">
  <table class="forecast">
    <caption>Pollen forecast for {{ cityName }}: overall level per day (highest forecast value)</caption>
    <thead>
      <tr>
        {%- for day in days %}
        <th scope="col"><span>{{ day.date | weekdayEn }}</span><br><time class="fc-date" datetime="{{ day.date }}">{{ day.date | dayMonthGb }}</time></th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      <tr>
        {%- for day in days %}
        {%- if day.overallLevel == null %}
        <td><span class="fc-word text-secondary">—</span></td>
        {%- else %}
        <td style="--_lv: var(--level-{{ cssLevel(day.overallLevel) }})">
          <div class="fc-bar" aria-hidden="true"><i style="block-size: {{ LEVEL_ORDINAL[day.overallLevel] }}%"></i></div>
          <span class="fc-word">{{ LEVEL_EN[day.overallLevel] }}</span>
          {%- if day.dominant %}<br><span class="fc-val small text-secondary">{{ names[day.dominant] }}</span>{% endif %}
        </td>
        {%- endif %}
        {%- endfor %}
      </tr>
    </tbody>
  </table>
</div>
{% endmacro %}

{# A city's own month-by-month table from cityClimatology.json, in English. #}
{% macro climatologyGb(clima, types, names, monthNames, monthFull, currentMonth, cityName) %}
<div class="scroller">
  <table class="bytype clima">
    <caption>{{ cityName }} pollen calendar: average level each month by type (mean of daily highs, grains/m³)</caption>
    <thead>
      <tr>
        <th scope="col">Type</th>
        {%- for mo in monthNames %}
        <th scope="col"{% if loop.index0 == currentMonth %} aria-current="date"{% endif %}><abbr title="{{ monthFull[loop.index0] }}">{{ mo }}</abbr></th>
        {%- endfor %}
      </tr>
    </thead>
    <tbody>
      {%- for id in types %}
      <tr>
        <th scope="row">{{ names[id] }}</th>
        {%- for c in clima[id] %}
        {%- if c == null %}
        <td class="bt-cell bt-none{% if loop.index0 == currentMonth %} bt-now{% endif %}"><span class="bt-word">no data</span></td>
        {%- elif c.value < 1 %}
        <td class="bt-cell bt-none{% if loop.index0 == currentMonth %} bt-now{% endif %}"><span class="bt-word">near zero</span><span class="bt-val">{{ c.value }}</span></td>
        {%- else %}
        <td class="bt-cell bd-{{ cssLevel(c.level) }}{% if loop.index0 == currentMonth %} bt-now{% endif %}"><span class="bt-word">{{ LEVEL_EN[c.level] }}</span><span class="bt-val">{{ c.value }}</span></td>
        {%- endif %}
        {%- endfor %}
      </tr>
      {%- endfor %}
    </tbody>
  </table>
</div>
{% endmacro %}

{# Update line for the CAMS pages in English. #}
{% macro updateLineGb(fetchedAt, stale) %}
<p class="update-line">
  <span>{% if stale %}Data from{% else %}Updated{% endif %} <time datetime="{{ fetchedAt }}">{{ fetchedAt | stampGb }}</time> (UK time)</span>
  <span>· Source: <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a>, Copernicus CAMS model</span>
</p>
{% endmacro %}
